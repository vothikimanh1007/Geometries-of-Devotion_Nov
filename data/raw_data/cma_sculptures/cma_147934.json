  "inscriptions": [
    {
      "inscription": "南無阿彌陀佛",
      "inscription_translation": "Namo amituofo or \"Homage to the Buddha Amitābha\"",
      "inscription_remark": "The sacred phrase, which practitioners repeat to secure entry into paradise, is repeated 10 times above the painting.",
      "sortorder": 1
    },
    {
      "inscription": "沙門善導",
      "inscription_translation": "Inscription and seal purportedly of Shandao (613–681), Tang dynasty patriarch of the Pure Land school, on the lower left side of the painting.",
      "inscription_remark": null,
      "sortorder": 2
    },
    {
      "inscription": "觀世音菩薩",
      "inscription_translation": "Bodhisattva Guanyin (Avalokiteśvara)",
      "inscription_remark": "Figure on the right",
      "sortorder": 3
    },
    {
      "inscription": "大勢至菩薩",
      "inscription_translation": "Dashizhi Bodhisattva (Mahāsthāmaprāpta)",
      "inscription_remark": "Figure on the left",
      "sortorder": 4
    },
    {
      "inscription": "永隆元年十月十五日",
      "inscription_translation": "Inscription on the lower right side of the painting: the fifteenth day of the first month of the first year of the Tang Emperor Taizong's Yonglong reign period [680/681].",
      "inscription_remark": "The date on the inscription coincides with the death date of the Tang patriarch, Shandao. Such signing and dating was a fairly common practice to reinforce the authority of a work as an icon painting. No dishonest intention is to be suspected with these additions. [WKH]",
      "sortorder": 5
    }
  ],
